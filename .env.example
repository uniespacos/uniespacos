# =============================================================================
# Aplicação
# =============================================================================
APP_NAME=UniEspaços
APP_ENV=development
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_URL_WITHOUT_SCHEME=localhost
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Banco de dados
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=uniespacos
DB_USERNAME=uniespacos
DB_PASSWORD=uniespacossecretkey
# Registra cada SQL com valores no log. Só tem efeito em local/development; nunca ligar em produção.
DB_LOG_QUERIES=false

# =============================================================================
# Sessão, fila e cache — o projeto usa Postgres para os três, não Redis/Memcached
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database

CACHE_STORE=database

FILESYSTEM_DISK=local

# Drivers alternativos que o Laravel expõe por padrão, mas o projeto não usa
# hoje (nenhum código troca FILESYSTEM_DISK para 's3', nem CACHE_STORE/
# QUEUE_CONNECTION para 'redis'/'memcached'). Mantidos aqui só para o caso de
# precisar habilitar algum no futuro.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# E-mail
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=uniespacos@gmail.com
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="uniespacos@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=null
MAIL_TIMEOUT=10

# =============================================================================
# Frontend (Vite)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Reverb (WebSocket) — ver CLAUDE.md, regra 4: REVERB_SCHEME=http é só para a
# comunicação interna backend → Reverb dentro do Docker. Os VITE_REVERB_* são
# o que o browser usa para falar com o Caddy, então HTTPS/443 é o valor
# correto tanto em dev quanto em produção — não é um valor "só de prod".
# =============================================================================
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="reverb"
REVERB_PORT=9000
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${APP_URL_WITHOUT_SCHEME}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# =============================================================================
# Telescope (debug/profiling — opcional, desligado por padrão)
# =============================================================================
TELESCOPE_ENABLED=false

# =============================================================================
# Política de Privacidade (rota pública /privacidade) — false responde 404.
# Desligada até o texto final e o redesenho da página.
# =============================================================================
PRIVACY_PAGE_ENABLED=false

# =============================================================================
# Retenção de dados — provisório (DT-11), valor final na T-12.
# Prazos em dias. Valor <= 0 ou inválido pula a rotina (com aviso no log).
# Logs diários: o prazo é LOG_DAILY_DAYS (logging.channels.daily.days).
# =============================================================================
RETENCAO_JOBS_FALHOS_DIAS=30
RETENCAO_NOTIFICACOES_LIDAS_DIAS=90
RETENCAO_CACHE_DIAS=7
RETENCAO_SESSOES_DIAS=7
RETENCAO_TOKENS_REDEFINICAO_DIAS=1
RETENCAO_JOBS_PENDENTES_ALERTA_DIAS=7
